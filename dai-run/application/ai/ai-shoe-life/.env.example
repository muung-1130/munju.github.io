AWS_REGION=ap-northeast-2
PORT=8000
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
# 실제 서버의 EC2 IAM Role 또는 Kubernetes ServiceAccount IAM Role을 사용합니다.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY는 설정하거나 Git에 저장하지 않습니다.

# 실제 서버에서는 true. 로컬 UI 시험만 할 때는 false.
PERSIST_ANALYSIS_RESULTS=false
SERVE_DEMO=false

# 팀 MinIO. 자격증명은 CI/CD Secret 또는 Kubernetes Secret에만 저장합니다.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_VERIFY_TLS=true
OBJECT_STORAGE_BUCKET=shoe-life-images

# 객체 키 접두사
S3_PREFIX=shoe-life-analyses

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# 실제 서버에서는 고정값을 넣지 말고 기존 백엔드가 로그인 user_id를 요청마다 전달합니다.
RUNNING_RECORD_USER_ID=
RUNNING_RECORD_SHOE_ID=
