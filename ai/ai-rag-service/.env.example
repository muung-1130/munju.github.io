# AWS
AWS_REGION=ap-northeast-2
BEDROCK_KNOWLEDGE_BASE_ID=your-knowledge-base-id
BEDROCK_MODEL_ARN=your-bedrock-model-arn

# 입력 민감정보(PII) 차단용 Bedrock Guardrail (선택 — 비워두면 Python 키워드 체크만 사용)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.0.212:3000

# Database
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=your-db-user
PGPASSWORD=your-db-password
PGDATABASE=your-db-name
