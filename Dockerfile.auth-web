# syntax=docker/dockerfile:1
#
# NextAuth 세션/OAuth 전용 이미지. app/api/* 백엔드 로직 대부분은 services-msa/*로 이관됐고,
# 이 컨테이너는 /api/auth/[...nextauth](로그인·세션·OAuth 콜백)와 /api/health만 nginx에서 넘겨받는다.
# 프론트엔드(Dockerfile.frontend)와 동일한 Next.js 빌드 산출물을 쓰고 APP_ROLE=backend로 역할만
# 구분한다(middleware.ts가 이 값을 보고 /api/* 이외 요청을 차단) — NextAuth v4가 Next.js 라우트 핸들러에
# 강하게 결합돼 있어(CSRF 이중 제출 쿠키, JWT 인코딩 등) Express로 재구현하면 이미 배포된 11개
# MSA 서비스가 검증하는 next-auth.session-token 쿠키 형식과 어긋날 위험이 있다 — 그래서 프로토콜을
# 다시 구현하는 대신 이 역할만 남기고 나머지 코드/라우팅을 모두 걷어내는 방식으로 분리했다.

ARG ALPINE_VERSION=3.23


# --------------------------------------------------
# 1단계: 빌드 의존성 설치
# --------------------------------------------------
FROM node:20-alpine${ALPINE_VERSION} AS deps

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci \
    --no-audit \
    --no-fund


# --------------------------------------------------
# 2단계: Next.js 빌드
# --------------------------------------------------
FROM node:20-alpine${ALPINE_VERSION} AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build


# --------------------------------------------------
# 3단계: 최소 운영 이미지 (백엔드 역할)
# --------------------------------------------------
FROM alpine:${ALPINE_VERSION} AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    APP_ROLE=backend

# Node 실행에 필요한 최소 라이브러리와 인증서만 설치
RUN apk add --no-cache \
      libstdc++ \
      ca-certificates \
    && addgroup -S -g 10001 dairun \
    && adduser -S -D -H -u 10001 -G dairun dairun

# npm, npx, Corepack을 제외하고 Node 실행 파일만 복사
COPY --from=builder \
    /usr/local/bin/node \
    /usr/local/bin/node

# Next.js standalone 결과만 복사
COPY --from=builder --chown=10001:10001 \
    /app/.next/standalone ./

COPY --from=builder --chown=10001:10001 \
    /app/.next/static ./.next/static

COPY --from=builder --chown=10001:10001 \
    /app/public ./public

USER 10001:10001

EXPOSE 3000

CMD ["node", "server.js"]
